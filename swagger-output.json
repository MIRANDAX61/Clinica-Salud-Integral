    "/api/auth/register": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Registrar una cuenta",
        "description": "",
        "responses": {
          "201": {
            "description": "Cuenta creada. Devuelve id, email y role, sin contraseña."
          },
          "400": {
            "description": "Datos de registro inválidos."
          },
          "409": {
            "description": "El correo ya está registrado."
          },
          "500": {
            "description": "Error al registrar la cuenta."
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "RECEPCIONISTA",
                      "MEDICO",
                      "GERENCIA"
                    ]
                  }
                }
              },
              "example": {
                "email": "recepcion.demo@clinica.com",
                "password": "123456",
                "role": "RECEPCIONISTA"
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión y obtener un token",
        "description": "",
        "responses": {
          "200": {
            "description": "Credenciales válidas. Devuelve un token JWT."
          },
          "400": {
            "description": "Datos de acceso inválidos."
          },
          "401": {
            "description": "Credenciales inválidas."
          },
          "500": {
            "description": "Error al iniciar sesión."
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              },
              "example": {
                "email": "recepcion.demo@clinica.com",
                "password": "123456"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
