                  }
                }
              },
              "example": {
                "email": "recepcion.demo@clinica.com",
                "password": "123456"
              }
            }
          }
        }
      }
    },
    "/api/appointments": {
      "post": {
        "tags": [
          "Citas"
        ],
        "summary": "Agendar una cita — RECEPCIONISTA",
        "description": "",
        "responses": {
          "201": {
            "description": "Cita creada con estado PROGRAMADA."
          },
          "400": {
            "description": "Datos inválidos o fecha que no es futura."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "El rol no tiene permiso."
          },
          "404": {
            "description": "Paciente o médico inexistente."
          },
          "500": {
            "description": "Error interno del servidor."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "paciente_id",
                  "medico_id",
                  "fecha_hora"
                ],
                "properties": {
                  "paciente_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "medico_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fecha_hora": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "example": {
                "paciente_id": 1,
                "medico_id": 2,
                "fecha_hora": "2026-12-01T10:00:00-04:00"
              }
            }
          }
        }
      }
    },
    "/api/doctors/{id}/appointments": {
      "get": {
        "tags": [
          "Citas"
        ],
        "summary": "Consultar agenda del médico — MEDICO",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "integer"
                },
                "minimum": {
                  "type": "number",
                  "example": 1
                }
              }
            },
            "description": "ID del médico."
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Día inicial. Enviar junto con to.",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "string"
                },
                "format": {
                  "type": "string",
                  "example": "date"
                }
              }
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Día final incluido, en horario de Bolivia.",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "string"
                },
                "format": {
                  "type": "string",
                  "example": "date"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agenda con los datos de los pacientes."
          },
          "400": {
            "description": "ID o rango de fechas inválido."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "El rol no tiene permiso."
          },
          "404": {
            "description": "Médico inexistente."
          },
          "500": {
            "description": "Error interno del servidor."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
