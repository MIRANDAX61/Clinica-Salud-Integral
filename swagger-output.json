{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Clínica Salud Integral",
    "description": "Documentación automática generada para la clínica",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/specialties": {
      "get": {
        "tags": [
          "Especialidades"
        ],
        "summary": "Consultar especialidades — RECEPCIONISTA",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/patients": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Consultar todos los pacientes",
        "description": "",
        "responses": {
          "200": {
            "description": "Lista de pacientes dentro de data."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "Se requiere el rol RECEPCIONISTA."
          },
          "500": {
            "description": "Error interno del servidor."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Crear un Paciente",
        "description": "",
        "responses": {
          "201": {
            "description": "Paciente registrado."
          },
          "400": {
            "description": "Datos inválidos o fecha de nacimiento futura."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "Se requiere el rol RECEPCIONISTA."
          },
          "500": {
            "description": "Error interno del servidor."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nombre",
                  "apellido",
                  "correo",
                  "fecha_nacimiento"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1
                  },
                  "apellido": {
                    "type": "string",
                    "minLength": 1
                  },
                  "correo": {
                    "type": "string",
                    "format": "email"
                  },
                  "carnet_identidad": {
                    "type": "string",
                    "minLength": 1
                  },
                  "telefono": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fecha_nacimiento": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "example": {
                "nombre": "Lucía",
                "apellido": "Mendoza",
                "correo": "lucia@ejemplo.com",
                "fecha_nacimiento": "2000-05-20"
              }
            }
          }
        }
      }
    },
    "/api/patients/{id}": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Consultar un paciente por su ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID del paciente."
          }
        ],
        "responses": {
          "200": {
            "description": "Paciente con sus citas, médicos y especialidades."
          },
          "400": {
            "description": "ID inválido."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "Se requiere el rol RECEPCIONISTA."
          },
          "404": {
            "description": "Paciente no encontrado."
          },
          "500": {
            "description": "Error interno del servidor."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/doctors": {
      "get": {
        "tags": [
          "Médicos"
        ],
        "summary": "Consultar médicos por especialidad — RECEPCIONISTA",
        "description": "",
        "parameters": [
          {
            "name": "specialty",
            "in": "query",
            "required": false,
            "description": "Nombre completo de la especialidad, sin distinguir mayúsculas.",
            "schema": {
              "type": "string",
              "example": "Pediatría"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de médicos con los datos de su especialidad."
          },
          "400": {
            "description": "Filtro de especialidad inválido."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "Se requiere el rol RECEPCIONISTA."
          },
          "500": {
            "description": "Error al consultar médicos."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Registrar una cuenta",
        "description": "",
        "responses": {
          "201": {
            "description": "Cuenta creada. Devuelve id, email y role, sin contraseña."
          },
          "400": {
            "description": "Datos de registro inválidos."
          },
          "409": {
            "description": "El correo ya está registrado."
          },
          "500": {
            "description": "Error al registrar la cuenta."
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "RECEPCIONISTA",
                      "MEDICO",
                      "GERENCIA"
                    ]
                  }
                }
              },
              "example": {
                "email": "recepcion.demo@clinica.com",
                "password": "123456",
                "role": "RECEPCIONISTA"
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión y obtener un token",
        "description": "",
        "responses": {
          "200": {
            "description": "Credenciales válidas. Devuelve un token JWT."
          },
          "400": {
            "description": "Datos de acceso inválidos."
          },
          "401": {
            "description": "Credenciales inválidas."
          },
          "500": {
            "description": "Error al iniciar sesión."
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              },
              "example": {
                "email": "recepcion.demo@clinica.com",
                "password": "123456"
              }
            }
          }
        }
      }
    },
    "/api/appointments": {
      "post": {
        "tags": [
          "Citas"
        ],
        "summary": "Agendar una cita — RECEPCIONISTA",
        "description": "",
        "responses": {
          "201": {
            "description": "Cita creada con estado PROGRAMADA."
          },
          "400": {
            "description": "Datos inválidos o fecha que no es futura."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "El rol no tiene permiso."
          },
          "404": {
            "description": "Paciente o médico inexistente."
          },
          "500": {
            "description": "Error interno del servidor."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "paciente_id",
                  "medico_id",
                  "fecha_hora"
                ],
                "properties": {
                  "paciente_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "medico_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fecha_hora": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "example": {
                "paciente_id": 1,
                "medico_id": 2,
                "fecha_hora": "2026-12-01T10:00:00-04:00"
              }
            }
          }
        }
      }
    },
    "/api/doctors/{id}/appointments": {
      "get": {
        "tags": [
          "Citas"
        ],
        "summary": "Consultar agenda del médico — MEDICO",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID del médico."
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Día inicial. Enviar junto con to.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Día final incluido, en horario de Bolivia.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agenda con los datos de los pacientes."
          },
          "400": {
            "description": "ID o rango de fechas inválido."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "El rol no tiene permiso."
          },
          "404": {
            "description": "Médico inexistente."
          },
          "500": {
            "description": "Error interno del servidor."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/appointments/{id}/status": {
      "patch": {
        "tags": [
          "Citas"
        ],
        "summary": "Actualizar estado de una cita — MEDICO",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID de la cita."
          }
        ],
        "responses": {
          "200": {
            "description": "Cita actualizada."
          },
          "400": {
            "description": "ID o estado inválido."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "El rol no tiene permiso."
          },
          "404": {
            "description": "Cita inexistente."
          },
          "500": {
            "description": "Error interno del servidor."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "estado"
                ],
                "properties": {
                  "estado": {
                    "type": "string",
                    "enum": [
                      "COMPLETADA",
                      "CANCELADA"
                    ]
                  }
                }
              },
              "example": {
                "estado": "COMPLETADA"
              }
            }
          }
        }
      }
    },
    "/api/reports/appointments-by-specialty": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "summary": "Total de citas por especialidad — GERENCIA",
        "description": "",
        "responses": {
          "200": {
            "description": "Cantidad de citas agrupadas por especialidad."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "Se requiere el rol GERENCIA."
          },
          "500": {
            "description": "Error al generar el reporte."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/reports/daily-cutoff": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "summary": "Corte diario de citas — GERENCIA",
        "description": "",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Día de las citas en horario de Bolivia.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cantidad de citas completadas y canceladas del día."
          },
          "400": {
            "description": "Fecha ausente o inválida."
          },
          "401": {
            "description": "Token ausente, inválido o expirado."
          },
          "403": {
            "description": "Se requiere el rol GERENCIA."
          },
          "500": {
            "description": "Error al generar el corte diario."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}